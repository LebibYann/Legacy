FRONTEND_DNS=frontend
NEW_FRONTEND_PORT=5174
OLD_FRONTEND_PORT=2317

BACKOFFICE_USERNAME=admin
BACKOFFICE_PASSWORD=admin

APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8000


MODE=prod
DB_HOST=db
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=geneweb
PORT=8000
HOST=0.0.0.0

GWB_PATH=/app/geneweb/distribution/bases
