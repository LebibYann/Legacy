APP_ENV=dev
APP_NAME=geneweb-backend
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/geneweb
DATABASE_ECHO=false  # Set to true to enable SQL query logging for debugging
DATABASE_FUTURE=true  # Use SQLAlchemy 2.0 style (recommended, should stay true)

ALLOWED_IPS=["127.0.0.1","::1"]
