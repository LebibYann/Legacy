# ---- Dev stage ----
FROM node:24-alpine

# Set working directory
WORKDIR /app

# Copy the code
COPY . .

# Install dependencies
RUN npm install

# Expose Vite dev server port
EXPOSE 5174

# Create .env file
RUN echo "PORT=5174" > .env

# Start the dev server
ENTRYPOINT [ "npm", "run", "dev", "--", "--host" ]
